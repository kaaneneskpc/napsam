# --- Django ---
# Uretimde MUTLAKA yeni bir deger uret:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Supabase Postgres ---
# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler
# Sunucusuz (Vercel) icin transaction pooler (port 6543) kullan.
# Bos birakilirsa lokalde SQLite'a duser.
DATABASE_URL=

# --- AI katmani (opsiyonel, Faz 4) ---
# Bos ise uygulama tamamen seed havuzuyla calisir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NAPSAM_AI_DAILY_LIMIT=5
